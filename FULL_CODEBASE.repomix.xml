<file path="templates/post_detail.html">
{% match post %}
{%- when Some with (post) -%}
<article class="post-detail-card">
    <div class="post-detail-header">
        <a href="/blog"
           data-hx-get="/blog"
           data-hx-target="#main-content"
           data-hx-swap="innerHTML"
           data-hx-push-url="true"
           class="back-link">&larr; Back to Blog</a>

        <div class="post-actions post-detail-actions">
            <a href="/posts/{{ post.id_hex }}/edit?from=post"
               data-hx-get="/posts/{{ post.id_hex }}/edit?from=post"
               data-hx-target="#main-content"
               data-hx-swap="innerHTML"
               data-hx-push-url="true"
               class="action-btn edit-btn"
               title="Edit post">&#9998;</a>

            <button type="button"
                    class="action-btn delete-btn"
                    data-hx-delete="/api/posts/{{ post.id_hex }}?redirect=blog"
                    data-hx-confirm="Are you sure you want to delete this post?"
                    data-hx-target="#main-content"
                    data-hx-swap="innerHTML"
                    data-hx-sync="this:drop"
                    data-hx-disable="this"
                    title="Delete post">&times;</button>
        </div>
    </div>

