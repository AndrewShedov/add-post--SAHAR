</article>
{%- when None -%}
<div class="card">
    <h2>404 — Post not found</h2>
    <p class="post-counter">This post does not exist or has been deleted.</p>
    <a href="/blog"
       data-hx-get="/blog"
       data-hx-target="#main-content"
       data-hx-swap="innerHTML"
       data-hx-push-url="true"
       class="btn">Back to Blog</a>
</div>
{%- endmatch -%}
</file>

<file path="templates/post_edit.html">
{% match post %}
{% when Some with (post) %}
<div class="card" id="edit-card">
    <h2>Edit post</h2>
    
    <form id="edit-form"
          action="/api/posts/{{ post.id_hex }}/edit"
          method="POST"
          data-hx-post="/api/posts/{{ post.id_hex }}/edit"
          data-hx-target="#main-content"
          data-hx-swap="innerHTML"
          data-hx-sync="this:drop"
          data-hx-disable="find button[type='submit']"
          autocomplete="off">
        <div class="input-group">
            <label for="edit-title">Title</label>
            <input type="text"
                   id="edit-title"
                   name="title"
                   class="input-field"
                   autocomplete="off"
                   maxlength="150"
                   placeholder="Max 150 chars"
                   value="{{ post.title }}"
                   data-original="{{ post.title }}">
        </div>

        <div class="input-group">
            <label for="edit-content">* Text</label>
            <textarea id="edit-content"
                      name="content"
                      class="input-field textarea"
                      autocomplete="off"
                      required
                      maxlength="3000"
                      placeholder="Max 3000 chars"
                      data-original="{{ post.content }}">{{ post.content }}</textarea>
        </div>

        <div class="edit-buttons-row">
            <a href="{{ back_url }}"
               data-hx-get="{{ back_url }}"
               data-hx-target="#main-content"
               data-hx-swap="innerHTML"
               data-hx-push-url="true"
               class="btn btn-outline">Back</a>

            <button type="button"
                    id="cancel-edit-btn"
                    class="btn btn-outline hidden"
                    hidden>Cancel</button>

            <button type="submit"
                    id="publish-edit-btn"
                    class="btn btn-black hidden"
                    hidden
                    disabled>Publish</button>
        </div>
    </form>
</div>
{% when None %}
<div class="card">
    <h2>404 — Post not found</h2>
    <p class="post-counter">This post does not exist or has been deleted.</p>
    <a href="/blog"
       data-hx-get="/blog"
       data-hx-target="#main-content"
       data-hx-swap="innerHTML"
       data-hx-push-url="true"
       class="btn">Back to Feed</a>
</div>
{% endmatch %}
</file>

<file path="templates/post_items.html">
{% for post in posts %}
<article class="post-item">
    <!-- Edit (pencil) and Delete (cross) actions -->
    <div class="post-actions">
        <a href="/posts/{{ post.id_hex }}/edit?from=blog" data-hx-get="/posts/{{ post.id_hex }}/edit?from=blog"
            data-hx-target="#main-content" data-hx-swap="innerHTML" data-hx-push-url="true" class="action-btn edit-btn"
            title="Edit post">&#9998;</a>

        <button type="button" class="action-btn delete-btn" data-hx-delete="/api/posts/{{ post.id_hex }}"
            data-hx-confirm="Are you sure you want to delete this post?" data-hx-swap="none" data-hx-sync="this:drop" data-hx-disable="this" title="Delete post">&times;
        </button>
    </div>

    <!-- Full-card semantic link for SEO and SPA navigation -->
    <a href="/posts/{{ post.id_hex }}" data-hx-get="/posts/{{ post.id_hex }}" data-hx-target="#main-content" data-hx-swap="innerHTML"
        data-hx-push-url="true" class="post-card-link">
        {% if !post.title.is_empty() %}
        <h2 class="post-title" data-hx-ignore dir="auto">{{ post.title }}</h2>
        {% endif %}
        <p class="post-text" data-hx-ignore dir="auto">{{ post.content }}</p>
        <span class="post-date">{{ post.date_str }}</span>
    </a>
</article>
{% endfor %}

{% if let Some(ts) = next_timestamp %}
<!-- Hybrid Infinite Scroll trigger (for humans) + Crawlable SEO link (for search bots) -->
<div class="scroll-loader" data-hx-get="/blog?before={{ ts }}" data-hx-trigger="revealed"
    data-hx-swap="outerHTML">
    <a href="/blog?before={{ ts }}">Loading more posts... ⏳</a>
</div>
{% endif %}
</file>

<file path="templates/toast.html">
<div id="toast-container" data-hx-swap-oob="innerHTML">
    <div class="toast {% if is_success %}success{% else %}error{% endif %}">
        <span>{{ message }}</span>
        <button type="button" class="toast-close">&times;</button>
    </div>
</div>
</file>

